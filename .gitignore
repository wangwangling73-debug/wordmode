# Python and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

# Credentials and machine-local settings
.env
.env.*
!.env.example
*.pem
*.key
.codex/
.agents/
.idea/
.vscode/
Thumbs.db
.DS_Store

# Downloadable datasets and temporary downloads
/data/
/pip_temp/

# Keep the default checkpoints; omit duplicate experimental runs
/runs_*/
!/runs_improved/
!/runs_v2/
/runs_improved/*
!/runs_improved/policy.pt
!/runs_improved/policy_last.pt
!/runs_improved/training_summary.json
/runs_v2/*
!/runs_v2/policy.pt
/runs/*
!/runs/policy.pt

# Published world-model experiments: weights, metrics, and summaries
!/runs_world/
/runs_world/*
!/runs_world/world.pt
!/runs_world/world_last.pt
!/runs_world/world_metrics.jsonl
!/runs_world/world_summary.json
!/runs_world_manual/
/runs_world_manual/*
!/runs_world_manual/world.pt
!/runs_world_manual/world_last.pt
!/runs_world_manual/world_metrics.jsonl
!/runs_world_manual/world_summary.json

# Synthetic debugging artifacts
/outputs/test_checkpoints/

# Paper downloads, renders, and unfinished reading drafts
/paper_readings/

# Generic temporary files
*.tmp
*.log
